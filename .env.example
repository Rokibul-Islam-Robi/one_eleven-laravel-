APP_NAME=bHerb
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Same database the original PHP project used (XAMPP defaults)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bherb
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# ---- Payment gateways (all optional; with none set the offline demo gateway is used) ----
# BHERB_PAYMENT_MODE=demo            # demo | sandbox | live
# BHERB_SSLCZ_STORE_ID=
# BHERB_SSLCZ_STORE_PASS=
# BHERB_SSLCZ_LIVE_STORE_ID=
# BHERB_SSLCZ_LIVE_STORE_PASS=
# BHERB_BKASH_USERNAME=
# BHERB_BKASH_PASSWORD=
# BHERB_BKASH_APP_KEY=
# BHERB_BKASH_APP_SECRET=
# BHERB_BKASH_LIVE_USERNAME=
# BHERB_BKASH_LIVE_PASSWORD=
# BHERB_BKASH_LIVE_APP_KEY=
# BHERB_BKASH_LIVE_APP_SECRET=
# BHERB_NAGAD_MERCHANT_ID=
# BHERB_NAGAD_ACCOUNT_NUMBER=
# BHERB_NAGAD_CURRENCY_CODE=050
# BHERB_NAGAD_PG_PUBLIC_KEY=
# BHERB_NAGAD_MERCHANT_PRIVATE_KEY=
# BHERB_NAGAD_LIVE_MERCHANT_ID=
# BHERB_NAGAD_LIVE_ACCOUNT_NUMBER=
# BHERB_NAGAD_LIVE_PG_PUBLIC_KEY=
# BHERB_NAGAD_LIVE_MERCHANT_PRIVATE_KEY=
